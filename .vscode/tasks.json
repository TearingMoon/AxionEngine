
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "linux"],
      "windows": {
        "args": ["--preset", "windows"]
      },
      "problemMatcher": []
    },
    {
      "label": "Build All",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "linux"],
      "windows": {
        "args": ["--build", "--preset", "windows"],
        "problemMatcher": ["$msCompile"]
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["Configure"]
    },
    {
      "label": "Run Tests",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/build/linux",
        "--output-on-failure"
      ],
      "windows": {
        "args": [
          "--test-dir",
          "${workspaceFolder}/build/windows",
          "--output-on-failure"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Build and Test",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build All",
        "Run Tests"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Pong",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "linux", "--target", "Pong"],
      "windows": {
        "args": ["--build", "--preset", "windows", "--target", "Pong"],
        "problemMatcher": ["$msCompile"]
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "dependsOn": ["Configure"]
    },
    {
      "label": "Build TwinStickShooter",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "linux", "--target", "TwinStickShooter"],
      "windows": {
        "args": ["--build", "--preset", "windows", "--target", "TwinStickShooter"],
        "problemMatcher": ["$msCompile"]
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "dependsOn": ["Configure"]
    },
    {
      "label": "Build Game Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "linux", "--target", "GameDebug"],
      "windows": {
        "args": ["--build", "--preset", "windows", "--target", "GameDebug"],
        "problemMatcher": ["$msCompile"]
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "dependsOn": ["Configure"]
    },
    {
      "label": "Build Launcher",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "linux", "--target", "GameLauncher"],
      "windows": {
        "args": ["--build", "--preset", "windows", "--target", "GameLauncher"],
        "problemMatcher": ["$msCompile"]
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "dependsOn": ["Configure"]
    },
    {
      "label": "Clean",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "linux", "--target", "clean"],
      "windows": {
        "args": ["--build", "--preset", "windows", "--target", "clean"]
      },
      "problemMatcher": []
    }
  ]
}
